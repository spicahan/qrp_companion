cmake_minimum_required(VERSION 3.16)

if(ESP_PLATFORM)
    project(desktop_skip NONE)
    return()
endif()

project(qrp_kiwisdr LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_AUTOMOC ON)

find_package(Qt5 REQUIRED COMPONENTS Widgets)
find_package(PkgConfig REQUIRED)
pkg_check_modules(PORTAUDIO REQUIRED portaudio-2.0)

add_executable(qrp_kiwisdr
    main_desktop.cpp
    pal_kiwisdr.cpp
    core/app.cpp
    core/dsp.cpp
    core/cat.cpp
    core/nco.cpp
    core/ui_state.cpp
    core/ui_widget.cpp
    core/mongoose/mongoose.c
    fft_shim/fft.cpp
)

target_compile_definitions(qrp_kiwisdr PRIVATE MG_ENABLE_LOG=0)

target_include_directories(qrp_kiwisdr PRIVATE
    .
    core
    fft_shim
    ${PORTAUDIO_INCLUDE_DIRS}
)

target_link_directories(qrp_kiwisdr PRIVATE ${PORTAUDIO_LIBRARY_DIRS})
target_link_libraries(qrp_kiwisdr Qt5::Widgets ${PORTAUDIO_LINK_LIBRARIES})
