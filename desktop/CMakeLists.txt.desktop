cmake_minimum_required(VERSION 3.16)

# When scanned by ESP-IDF, create a no-op project and exit
if(ESP_PLATFORM)
    project(desktop_skip NONE)
    return()
endif()

project(qrp_companion_desktop LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_AUTOMOC ON)

find_package(Qt5 REQUIRED COMPONENTS Widgets)

add_executable(qrp_companion_desktop
    main_desktop.cpp
    pal_desktop.cpp
    ../core/app.cpp
    ../core/dsp.cpp
    fft_shim/fft.cpp
)

target_include_directories(qrp_companion_desktop PRIVATE
    ../pal
    ../core
    fft_shim
)

target_link_libraries(qrp_companion_desktop Qt5::Widgets)
